{
  "description": "preflight --role reviewer, every check passes: OpenCode (config via OPENCODE_CONFIG, started with --agent loopctl-reviewer; the export has no variant, as observed with OpenCode 1.18.32) in the requested checkout, native turn with openai/gpt-6-astra read through `opencode session list` / `opencode export`, all five negatives rejected with resources unchanged, stop confirmed by process-info.",
  "calls": [
    {"id": "version", "match": ["--version"], "stdout": "herdr 0.9.1\n"},
    {"id": "open", "match": ["worktree", "open", "--cwd", "*", "--path", "*", "--label", "loopctl-preflight-reviewer", "--no-focus"],
     "capture": {"cwd": "--path (\\S+)"},
     "stdout": {"id": "cli:worktree:open", "result": {"type": "worktree_opened", "already_open": false,
                "root_pane": {"pane_id": "w1:p1", "cwd": "{cwd}", "foreground_cwd": "{cwd}"}}}},
    {"id": "config", "match": ["pane", "run", "w1:p1", "export OPENCODE_CONFIG=/*/profiles/reviewer.opencode.json"], "stdout": ""},
    {"id": "start", "match": ["agent", "start", "pf-reviewer-*", "--kind", "opencode", "--pane", "w1:p1", "--timeout", "30000", "--",
                               "--agent", "loopctl-reviewer", "-m", "openai/gpt-6-astra"],
     "stdout": {"id": "cli:agent:start", "result": {"agent": {"agent": "opencode", "agent_status": "idle", "interactive_ready": true,
                "cwd": "{cwd}", "pane_id": "w1:p1"}}}},
    {"id": "prompt", "match": ["agent", "prompt", "pf-reviewer-*", "*"],
     "capture": {"marker": "(LOOPCTL-PF-[0-9a-f]+)", "probe": "(/\\S*/loopctl-preflight-[0-9a-f]+)"},
     "stdout": {"id": "cli:agent:prompt", "result": {"type": "ok"}}},
    {"id": "sessions", "tool": "opencode", "match": ["session", "list", "--format", "json"],
     "stdout": [{"id": "ses_older", "directory": "/elsewhere", "created": 1, "updated": 1},
                {"id": "ses_fakeReviewer1", "directory": "{cwd}", "created": 2, "updated": 3}]},
    {"id": "export", "tool": "opencode", "match": ["export", "ses_fakeReviewer1"],
     "stdout": {"info": {"id": "ses_fakeReviewer1", "directory": "{cwd}", "version": "1.18.32"}, "messages": [
       {"info": {"id": "msg_u1", "sessionID": "ses_fakeReviewer1", "role": "user"},
        "parts": [{"type": "text", "text": "loopctl preflight {marker}"}]},
       {"info": {"id": "msg_a1", "sessionID": "ses_fakeReviewer1", "role": "assistant", "providerID": "openai", "modelID": "gpt-6-astra",
                 "agent": "loopctl-reviewer", "mode": "loopctl-reviewer", "finish": "tool-calls"},
        "parts": [
          {"type": "tool", "tool": "write", "state": {"status": "error", "input": {"filePath": "{probe}/outside.txt", "content": "{marker}"}, "error": "The user rejected permission to use this specific tool call."}},
          {"type": "tool", "tool": "bash", "state": {"status": "error", "input": {"command": "git push {probe}/remote.git HEAD:refs/heads/probe"}, "error": "The user rejected permission to use this specific tool call."}},
          {"type": "tool", "tool": "bash", "state": {"status": "error", "input": {"command": "gh --version > {probe}/gh.out"}, "error": "The user rejected permission to use this specific tool call."}},
          {"type": "tool", "tool": "bash", "state": {"status": "error", "input": {"command": "herdr --version > {probe}/herdr.out"}, "error": "The user rejected permission to use this specific tool call."}},
          {"type": "tool", "tool": "bash", "state": {"status": "error", "input": {"command": "loopctl decide handoff > {probe}/decide.out"}, "error": "The user rejected permission to use this specific tool call."}}]},
       {"info": {"id": "msg_a2", "sessionID": "ses_fakeReviewer1", "role": "assistant", "providerID": "openai", "modelID": "gpt-6-astra",
                 "agent": "loopctl-reviewer", "mode": "loopctl-reviewer", "finish": "stop"},
        "parts": [{"type": "text", "text": "All five attempts were rejected. {marker}"}]}]}},
    {"id": "stop", "match": ["agent", "send-keys", "pf-reviewer-*", "ctrl+c"],
     "stdout": {"id": "cli:agent:send-keys", "result": {"type": "ok"}}},
    {"id": "readback", "match": ["pane", "process-info", "--pane", "w1:p1"],
     "stdout": {"id": "cli:pane:process_info", "result": {"type": "pane_process_info", "process_info": {
                "pane_id": "w1:p1", "shell_pid": 100, "foreground_process_group_id": 100,
                "foreground_processes": [{"pid": 100, "name": "sh", "argv": ["/bin/sh"], "cwd": "{cwd}"}]}}}}
  ]
}
