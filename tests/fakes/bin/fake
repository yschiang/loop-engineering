#!/usr/bin/env python3
"""A fake of an external tool, answering from a scenario (design DD-10).

The tool is the basename of argv[0]. FAKE_SCENARIO names a JSON file
{tool: [entry, ...]}; FAKE_LOG names the JSON-lines log of every call,
{seq, tool, argv, captured, unexpected?, snapshot?}. Only the fakes read
these two variables; loopctl never does. What the calls so far captured,
used up and set is kept beside the log, in FAKE_LOG.state.

An entry is {match, stdout?, stderr?, exit?, effects?, repeat?, when?}:

- match: the whole argv, one pattern per argument: a string equals it;
  {"capture": name} takes any argument and keeps it as {name}.
- The first entry of the tool, in scenario order, that is not used up,
  whose `when` holds and whose match holds answers the call. It is used up
  unless it has `repeat: true`.
- when: {key: value} the state must hold; a key never set is null.
- effects, in order: {"write": {"path", "text", "append"?}} writes a file;
  {"state": {key: value}} sets the state; {"snapshot": dir} logs the files
  under dir with their text; {"kill_parent": true} ends the caller with
  SIGKILL once the call is answered, to interrupt loopctl mid-run.
- stdout, stderr, and the paths, texts and dirs of effects take {name} of
  every value captured so far.

When no entry of the tool matches `--version`, orca, claude and codex
answer it in the format of the real tools. Any other call is logged as
unexpected and exits 97.
"""

from __future__ import annotations

import fcntl
import json
import os
import signal
import sys
from pathlib import Path
from typing import Any

UNEXPECTED = 97

# `--version` of the real tools, unless the scenario lists it (DD-10).
VERSIONS = {
    "orca": "1.4.218\n",
    "claude": "2.1.288 (Claude Code)\n",
    "codex": "codex-cli 0.157.0\n",
}


def load(path: str | Path | None) -> Any:
    """The JSON in `path`, or None when there is no such file."""
    if not path:
        return None
    try:
        return json.loads(Path(path).read_text())
    except FileNotFoundError:
        return None


def capture(patterns: list[Any], argv: list[str]) -> dict[str, str] | None:
    """The values `argv` gives the captures of `patterns`, or None when it
    does not match them."""
    if len(patterns) != len(argv):
        return None
    taken: dict[str, str] = {}
    for pattern, arg in zip(patterns, argv, strict=True):
        if isinstance(pattern, dict):
            taken[pattern["capture"]] = arg
        elif pattern != arg:
            return None
    return taken


def substitute(text: str, captured: dict[str, str]) -> str:
    for name, value in captured.items():
        text = text.replace("{" + name + "}", value)
    return text


def snapshot(directory: Path) -> dict[str, str] | None:
    """Every file under `directory` with its text; None when it is missing."""
    if not directory.is_dir():
        return None
    return {
        path.relative_to(directory).as_posix(): path.read_text(errors="replace")
        for path in sorted(directory.rglob("*"))
        if path.is_file()
    }


def answer(
    tool: str, argv: list[str], entries: list[dict[str, Any]], memory: dict[str, Any]
) -> tuple[dict[str, Any] | None, dict[str, str]]:
    """The entry that answers this call and what it captured."""
    for index, entry in enumerate(entries):
        if f"{tool}:{index}" in memory["used"]:
            continue
        when = entry.get("when") or {}
        if any(memory["state"].get(key) != value for key, value in when.items()):
            continue
        taken = capture(entry["match"], argv)
        if taken is not None:
            if not entry.get("repeat"):
                memory["used"].append(f"{tool}:{index}")
            return entry, taken
    if (
        argv == ["--version"]
        and tool in VERSIONS
        and not any(capture(entry["match"], argv) is not None for entry in entries)
    ):
        return {"stdout": VERSIONS[tool]}, {}
    return None, {}


def apply(
    effects: list[dict[str, Any]], memory: dict[str, Any], record: dict[str, Any]
) -> bool:
    """Carry out `effects`; whether the caller is to be killed."""
    captured, kill = memory["captured"], False
    for effect in effects:
        if "write" in effect:
            write = effect["write"]
            path = Path(substitute(write["path"], captured))
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a" if write.get("append") else "w") as file:
                file.write(substitute(write["text"], captured))
        elif "state" in effect:
            memory["state"].update(effect["state"])
        elif "snapshot" in effect:
            directory = substitute(effect["snapshot"], captured)
            record.setdefault("snapshot", {})[directory] = snapshot(Path(directory))
        elif "kill_parent" in effect:
            kill = bool(effect["kill_parent"])
        else:
            raise ValueError(f"unknown effect {effect!r}")
    return kill


def main() -> int:
    tool, argv = Path(sys.argv[0]).name, sys.argv[1:]
    log = Path(os.environ["FAKE_LOG"])
    state = Path(f"{log}.state")
    with open(f"{log}.lock", "a") as lock:
        # One call at a time: the log, its seq and the state stay in order.
        fcntl.flock(lock, fcntl.LOCK_EX)
        entries = (load(os.environ.get("FAKE_SCENARIO")) or {}).get(tool, [])
        memory = load(state) or {"used": [], "captured": {}, "state": {}}
        found, taken = answer(tool, argv, entries, memory)
        memory["captured"].update(taken)
        seq = 1 + (len(log.read_text().splitlines()) if log.exists() else 0)
        record: dict[str, Any] = {
            "seq": seq,
            "tool": tool,
            "argv": argv,
            "captured": taken,
        }
        kill = False
        if found is None:
            record["unexpected"] = True
        else:
            kill = apply(found.get("effects", []), memory, record)
        with open(log, "a") as file:
            file.write(json.dumps(record) + "\n")
        state.write_text(json.dumps(memory))
    if found is None:
        sys.stderr.write(f"fake {tool}: unexpected call {json.dumps(argv)}\n")
        return UNEXPECTED
    captured = memory["captured"]
    sys.stdout.write(substitute(found.get("stdout", ""), captured))
    sys.stderr.write(substitute(found.get("stderr", ""), captured))
    sys.stdout.flush()
    sys.stderr.flush()
    if kill:
        os.kill(os.getppid(), signal.SIGKILL)
    return int(found.get("exit", 0))


if __name__ == "__main__":
    sys.exit(main())
